		n_out2p0.y = cos(theta) * -1.0;
		n_out2p0.z = cos(phi) * sin(theta);
		n_out2p0 = normalize(n_out2p0);
		
	}


	vec4 n_out4p0;
// Texture3D:4
	n_out4p0 = texture(tex3d_frg_4, n_out2p0);


// Output:0
	ALBEDO = vec3(n_out4p0.xyz);


}
"
