render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D tex_frg_6;



void fragment() {
// Input:2
	vec2 n_out2p0 = UV;


// Texture2D:6
	vec4 n_out6p0 = texture(tex_frg_6, n_out2p0);


// Input:3
	float n_out3p0 = TIME;


// FloatFunc:4
	float n_out4p0 = sin(n_out3p0);


// FloatOp:5
	float n_in5p1 = 2.00000;
	float n_out5p0 = n_out4p0 / n_in5p1;


// FloatOp:7
	float n_out7p0 = n_out6p0.x - n_out5p0;


// FloatFunc:8
	float n_out8p0 = round(n_out7p0);


// FloatOp:9
	float n_in9p1 = 0.10000;
	float n_out9p0 = n_out7p0 - n_in9p1;


// FloatOp:10
	float n_in10p0 = 1.00000;
	float n_out10p0 = n_in10p0 - n_out9p0;


// FloatFunc:13
	float n_out13p0 = round(n_out10p0);


// ColorConstant:12
	vec4 n_out12p0 = vec4(0.697265, 0.419576, 0.079102, 1.000000);


// VectorOp:11
	vec3 n_out11p0 = vec3(n_out13p0) * vec3(n_out12p0.xyz);


// Output:0
	ALPHA = n_out8p0;
	EMISSION = n_out11p0;


}
