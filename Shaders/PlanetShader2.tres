code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler3D tex3d_frg_9;
uniform float FloatParameter4 = 0.60000002384186;
uniform sampler3D tex3d_frg_18;
uniform vec4 ColorParameter : source_color = vec4(0.037522, 0.275378, 1.000000, 1.000000);



void fragment() {
// Input:4
	vec2 n_out4p0 = UV;


	vec3 n_out2p0;
// Expression:2
	n_out2p0 = vec3(0.0, 0.0, 0.0);
	{
		float theta = n_out4p0.y * 3.14159;
		float phi = n_out4p0.x * 3.14159 * 2.0;
		
		n_out2p0.x = sin(phi) * sin(theta);
		n_out2p0.y = cos(theta) * -1.0;
		n_out2p0.z = cos(phi) * sin(theta);
		n_out2p0 = normalize(n_out2p0);
		
	}


	vec4 n_out9p0;
// Texture3D:9
	n_out9p0 = texture(tex3d_frg_9, n_out2p0);


// FloatParameter:17
	float n_out17p0 = FloatParameter4;


	vec4 n_out18p0;
// Texture3D:18
	n_out18p0 = texture(tex3d_frg_18, n_out2p0);


// Step:16
	vec3 n_out16p0 = step(n_out17p0, vec3(n_out18p0.xyz));


// VectorOp:19
	vec3 n_out19p0 = vec3(n_out9p0.xyz) * n_out16p0;


// VectorFunc:20
	vec3 n_out20p0 = vec3(1.0) - n_out16p0;


// ColorParameter:22
	vec4 n_out22p0 = ColorParameter;


// VectorOp:21
	vec3 n_out21p0 = n_out20p0 * vec3(n_out22p0.xyz);


// VectorOp:23
	vec3 n_out23p0 = n_out19p0 + n_out21p0;


// Output:0
	ALBEDO = n_out23p0;


}
